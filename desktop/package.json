{
  "name": "arborist-square-this-up-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Square This Up (arborist edition) Windows desktop shell (Electron)",
  "main": "main.js",
  "author": "Square This Up",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack:win": "electron-builder --win --x64",
    "pack:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.squarethisup.arborist.desktop",
    "productName": "Square This Up",
    "copyright": "Copyright © Square This Up",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "session-store.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "ui",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
