# Local / device API base (no trailing slash). See README.md.
EXPO_PUBLIC_API_URL=http://localhost:3000

# HTTPS host used for Universal Links / App Links (no scheme).
# Must match APP_ORIGIN host in production (e.g. jobs.yourdomain.com).
EXPO_PUBLIC_LINK_HOST=jobs.yourdomain.com

# Store listing / App Review (More → Legal). Leave blank until live HTTPS pages exist.
# Do not invent a privacy route in the web app unless you publish one.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://squarethisup.com/privacy
# EXPO_PUBLIC_SUPPORT_URL=https://squarethisup.com

# Optional: set after `eas init` links this app to an Expo project.
# EAS_PROJECT_ID=
