APP_ORIGIN=http://localhost:5173
PORT=3000
# Local development persists in SQLite. Production must use MySQL.
SQLITE_PATH=.data/job-tracker.sqlite
# Optional: Google Places Autocomplete on Add/Edit Client (browser key).
# When unset, free Photon suggestions via /api/address-suggest (or manual entry).
# VITE_GOOGLE_PLACES_API_KEY=
# Desktop Electron packaged builds only (not used for normal Hostinger web build):
# VITE_DESKTOP=true
# VITE_API_URL=https://jobs.yourdomain.com
# NODE_ENV=production
# Production target: APP_ORIGIN=https://squarethisup.com
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_NAME=your-database
# DB_USER=your-database-user
# DB_PASSWORD=set-in-hostinger
# DB_SSL=true
# Photos: 4 MB per upload, 100 MB total per account by default.
ACCOUNT_STORAGE_MB=100
# Optional email recovery. Without SMTP, use the account reset command.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mailbox
# SMTP_PASSWORD=set-in-hostinger
# MAIL_FROM=Square This Up <your-mailbox@example.com>
# Optional: estimate sign links use the same SMTP when channel=email.
# Without SMTP, the app returns a copyable sign link (SMS is always stubbed until a provider is configured).
